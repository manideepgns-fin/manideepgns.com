# The site's own code (styles and scripts) changes with every release, and a page must never run
# against yesterday's copy: a stale site.css once left every drawing unstyled for up to four hours.
# Always revalidate; unchanged files answer 304 at once. The images under assets/ revalidate too: small, and the 304 is cheap.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
# Fonts never change in place (a new font gets a new file name): let browsers keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
